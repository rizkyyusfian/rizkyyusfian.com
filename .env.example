# Public site URL (used for canonical URLs + sitemap). Falls back to https://rizkyyusfian.com
NEXT_PUBLIC_SITE_URL=https://rizkyyusfian.com

# GitHub token — for the live contributions widget. Fine-grained, read-only (no scopes needed for public contributions).
GITHUB_TOKEN=

# Spotify — for the now-playing widget. See the setup steps in the README / chat.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Umami analytics
#  Client tracking script (PUBLIC_ = exposed to the browser):
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
#  Server-side stats API (for the sidebar view/visitor counts):
UMAMI_API_URL=https://api.umami.is
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=
# ...or for a self-hosted Umami, use a bearer token instead of the api key:
# UMAMI_API_TOKEN=
