# Public site URL (used for canonical URLs + sitemap). Falls back to https://rizkyyusfian.dev
NEXT_PUBLIC_SITE_URL=https://rizkyyusfian.dev

# GitHub token — for the live contributions widget. Fine-grained, read-only (no scopes needed for public contributions).
GITHUB_TOKEN=

# Spotify — for the now-playing widget. See the setup steps in the README / chat.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Umami analytics
#  Client tracking script (PUBLIC_ = exposed to the browser):
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
#  Server-side stats (for the sidebar view/visitor counts). Pick ONE:
UMAMI_API_URL=https://api.umami.is
#  (A) FREE plan — enable "Share URL" on the website, paste the share id (the code after /share/):
UMAMI_SHARE_ID=
#  (B) Paid Umami Cloud — an API key instead:
# UMAMI_WEBSITE_ID=
# UMAMI_API_KEY=
#  (C) Self-hosted — a bearer token instead:
# UMAMI_WEBSITE_ID=
# UMAMI_API_TOKEN=
