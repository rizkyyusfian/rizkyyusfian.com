---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';
import { socials, gaming, site } from '../../siteConfig';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('nav.contact')} variant="page" termPath="~/contact">
  <div class="crumbs"><span>~</span><span class="sep">/</span><span class="cur2">contact</span></div>
  <h1 class="page-title"><Icon name="lucide:mail" /> {t('nav.contact')}</h1>
  <p class="page-lead">{t('contact.lead')}</p>

  <div class="contact-grid">
    {socials.map((s) => (
      <a class="contact-card" href={s.href} target="_blank" rel="me noopener">
        <span class="contact-ico"><Icon name={s.icon} /></span>
        <span class="contact-txt">
          <b>{s.label}</b>
          <span class="contact-handle">{s.handle}</span>
        </span>
        <Icon name="lucide:arrow-up-right" class="contact-arrow" />
      </a>
    ))}
  </div>

  <h4 class="contact-subhead"><Icon name="lucide:gamepad-2" /> {lang === 'id' ? 'Ngobrol & main bareng' : 'Chat & play'}</h4>
  <div class="contact-grid">
    {gaming.map((s) => (
      <a class="contact-card alt" href={s.href} target="_blank" rel="noopener">
        <span class="contact-ico"><Icon name={s.icon} /></span>
        <span class="contact-txt">
          <b>{s.label}</b>
          <span class="contact-handle">{s.handle}</span>
        </span>
        <Icon name="lucide:arrow-up-right" class="contact-arrow" />
      </a>
    ))}
  </div>

  <p class="contact-loc"><Icon name="lucide:map-pin" /> {site.location}</p>
</BaseLayout>
