---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';
import { socials, site } from '../../siteConfig';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('nav.contact')} variant="page" termPath="~/contact" termWin="cat">
  <div class="crumbs"><span>~</span><span class="sep">/</span><span class="cur2">contact</span></div>
  <h1 class="page-title">{t('nav.contact')}</h1>
  <p class="page-lead">{t('contact.lead')}</p>
  <div class="social-row">
    {socials.map((s) => (
      <a href={s.href} rel="me noopener">
        <Icon name={s.icon} /> {s.label}
      </a>
    ))}
  </div>
  <p class="page-lead" style="margin-top:18px">
    <Icon name="lucide:map-pin" /> {site.location}
  </p>
</BaseLayout>
