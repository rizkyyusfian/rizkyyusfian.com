---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations, localizePath } from '@i18n/utils';
import type { Lang } from '@i18n/ui';
import { getAllTags } from '../../lib/tags';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const tags = await getAllTags(lang);
---

<BaseLayout lang={lang} title={t('tags.all')} variant="page" termPath="~/tags">
  <div class="crumbs"><span>~</span><span class="sep">/</span><span class="cur2">tags</span></div>
  <h1 class="page-title">{t('tags.all')}</h1>
  <p class="page-lead">{t('tags.lead')}</p>

  <div class="tagcloud">
    {tags.length ? tags.map((tc) => (
      <a class="tagpill" href={localizePath(`/tags/${tc.tag}`, lang)}>
        <Icon name="lucide:hash" />{tc.tag}<span class="tagcount">{tc.count}</span>
      </a>
    )) : <p class="page-lead">{t('writing.empty')}</p>}
  </div>
</BaseLayout>
