---
import { Icon } from 'astro-icon/components';
import Search from 'astro-pagefind/components/Search.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import PostRow from '@components/PostRow.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';
import { getPosts } from '../../lib/blog';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const blogPosts = await getPosts(lang, 'blog');
const notePosts = await getPosts(lang, 'note');
---

<BaseLayout lang={lang} title={t('nav.blog')} variant="page" termPath={`~/blog`} termWin="ls">
  <div class="crumbs"><span>~</span><span class="sep">/</span><span class="cur2">blog</span></div>
  <h1 class="page-title"><Icon name="lucide:pen-line" /> {t('nav.blog')}</h1>
  <p class="page-lead">{lang === 'id' ? 'Tulisan dan catatan — dalam Bahasa Inggris dan Indonesia.' : 'Writing and notes — in English and Indonesian.'}</p>

  <div class="blog-search" data-pagefind-ignore>
    <Search id="blog-search" className="pagefind-ui" uiOptions={{ showImages: false, excerptLength: 15, resetStyles: false }} />
  </div>

  <div class="tabs" role="tablist" style="margin-top:10px">
    <button class="on" data-tab="blog" role="tab" aria-selected="true">{t('writing.blog')}</button>
    <button data-tab="note" role="tab" aria-selected="false">{t('writing.notes')}</button>
  </div>

  <div data-panel="blog" style="margin-top:8px">
    {blogPosts.length ? blogPosts.map((entry) => <PostRow entry={entry} lang={lang} />) : <p class="page-lead">{t('writing.empty')}</p>}
  </div>

  <div data-panel="note" hidden style="margin-top:8px">
    {notePosts.length ? notePosts.map((entry) => <PostRow entry={entry} lang={lang} />) : <p class="page-lead">{t('writing.empty')}</p>}
  </div>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll('[data-tab]');
  const panels = document.querySelectorAll('[data-panel]');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const key = tab.getAttribute('data-tab');
      tabs.forEach((t) => {
        const on = t === tab;
        t.classList.toggle('on', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach((p) => {
        (p as HTMLElement).hidden = p.getAttribute('data-panel') !== key;
      });
    });
  });
</script>
