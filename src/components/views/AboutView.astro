---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations, localizePath } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const cards = [
  { key: 'nav.peripherals', path: '/about/peripherals', icon: 'lucide:keyboard' },
  { key: 'nav.books', path: '/collections/books', icon: 'lucide:book-open' },
  { key: 'nav.film', path: '/collections/film', icon: 'lucide:clapperboard' },
  { key: 'nav.games', path: '/collections/games', icon: 'lucide:gamepad-2' },
  { key: 'nav.music', path: '/collections/music', icon: 'lucide:music' },
  { key: 'nav.hobby', path: '/collections/hobby', icon: 'lucide:sparkles' },
] as const;
---

<BaseLayout lang={lang} title={t('nav.about')} variant="page" termPath="~/about" termWin="cat">
  <div class="crumbs"><span>~</span><span class="sep">/</span><span class="cur2">about</span></div>
  <h1 class="page-title">{t('nav.about')}</h1>
  <p class="page-lead">{t('about.lead')}</p>

  <h4 style="margin-top:28px">{t('about.explore')}</h4>
  <div class="card-grid">
    {cards.map((c) => (
      <a class="card" href={localizePath(c.path, lang)}>
        <div class="ct"><Icon name={c.icon} /> {t(c.key)}</div>
      </a>
    ))}
  </div>
</BaseLayout>
