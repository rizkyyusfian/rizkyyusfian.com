---
import { Icon } from 'astro-icon/components';
import Search from 'astro-pagefind/components/Search.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import PostRow from '@components/PostRow.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';
import { getPosts, type Kind } from '../../lib/blog';

interface Props {
  lang: Lang;
  kind: Kind;
}
const { lang, kind } = Astro.props;
const t = useTranslations(lang);

const posts = await getPosts(lang, kind);
const isBlog = kind === 'blog';
const title = isBlog ? t('nav.blog') : t('nav.notes');
const lead = isBlog ? t('blog.lead') : t('notes.lead');
const crumb = isBlog ? 'blog' : 'notes';
const icon = isBlog ? 'lucide:pen-line' : 'lucide:notebook-pen';
---

<BaseLayout lang={lang} title={title} variant="page" termPath={`~/${crumb}`}>
  <div class="crumbs"><span>~</span><span class="sep">/</span><span class="cur2">{crumb}</span></div>
  <h1 class="page-title"><Icon name={icon} /> {title}</h1>
  <p class="page-lead">{lead}</p>

  {isBlog && (
    <div class="blog-search" data-pagefind-ignore>
      <Search className="pagefind-ui" uiOptions={{ showImages: false, excerptLength: 15, resetStyles: false }} />
    </div>
  )}

  <div style="margin-top:8px">
    {posts.length ? posts.map((entry) => <PostRow entry={entry} lang={lang} />) : <p class="page-lead">{t('writing.empty')}</p>}
  </div>
</BaseLayout>
