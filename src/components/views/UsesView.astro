---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';
import { localize } from '@/lib/collections';
import { uses } from '@/data/uses';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('nav.peripherals')} variant="page" termPath="~/about/peripherals">
  <div class="crumbs">
    <span>~</span><span class="sep">/</span><span>about</span><span class="sep">/</span><span class="cur2">peripherals</span>
  </div>
  <h1 class="page-title"><Icon name="lucide:keyboard" /> {t('nav.peripherals')}</h1>
  <p class="page-lead">{lang === 'id' ? 'Perangkat keras dan lunak yang saya pakai setiap hari.' : 'The hardware and software I use every day.'}</p>

  <div class="uses">
    {uses.map((g) => (
      <section class="uses-group">
        <h4><Icon name={g.icon} /> {g.group[lang] ?? g.group.en}</h4>
        <ul class="uses-list">
          {g.items.map((it) => (
            <li>
              <span class="uses-name">{it.link ? <a href={it.link} target="_blank" rel="noopener">{it.name}</a> : it.name}</span>
              {localize(it.note, lang) && <span class="uses-note">{localize(it.note, lang)}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
