---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';
import { localize } from '@/lib/collections';
import { uses } from '@/data/uses';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('nav.peripherals')} variant="page" termPath="~/about/peripherals">
  <div class="crumbs">
    <span>~</span><span class="sep">/</span><a href="/about">about</a><span class="sep">/</span><span class="cur2">peripherals</span>
  </div>
  <h1 class="page-title"><Icon name="lucide:keyboard" /> {t('nav.peripherals')}</h1>
  <p class="page-lead">{lang === 'id' ? 'Perangkat keras dan lunak yang saya pakai setiap hari.' : 'The hardware and software I use every day.'}</p>

  <div class="uses-grid">
    {uses.map((g) => (
      <section class="uses-card">
        <div class="uses-card-head">
          <span class="uses-chip"><Icon name={g.icon} /></span>
          <h4>{g.group[lang] ?? g.group.en}</h4>
          <span class="uses-n">{g.items.length}</span>
        </div>
        <ul class="uses-items">
          {g.items.map((it) => (
            <li>
              <Icon name="lucide:dot" class="uses-dot" />
              <div>
                <span class="uses-name">{it.link ? <a href={it.link} target="_blank" rel="noopener">{it.name}</a> : it.name}</span>
                {localize(it.note, lang) && <span class="uses-note">{localize(it.note, lang)}</span>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
