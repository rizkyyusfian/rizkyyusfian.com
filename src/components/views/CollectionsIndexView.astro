---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations, localizePath } from '@i18n/utils';
import type { Lang, UIKey } from '@i18n/ui';
import { books } from '@/data/books';
import { films } from '@/data/films';
import { games } from '@/data/games';
import { music } from '@/data/music';
import { hobbies } from '@/data/hobbies';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const groups: { key: UIKey; path: string; icon: string; items: { title: string }[] }[] = [
  { key: 'nav.books', path: '/collections/books', icon: 'lucide:book-open', items: books },
  { key: 'nav.film', path: '/collections/film', icon: 'lucide:clapperboard', items: films },
  { key: 'nav.games', path: '/collections/games', icon: 'lucide:gamepad-2', items: games },
  { key: 'nav.music', path: '/collections/music', icon: 'lucide:music', items: music },
  { key: 'nav.hobby', path: '/collections/hobby', icon: 'lucide:sparkles', items: hobbies },
];
---

<BaseLayout lang={lang} title={t('nav.collections')} variant="page" termPath="~/collections">
  <div class="crumbs"><span>~</span><span class="sep">/</span><span class="cur2">collections</span></div>
  <h1 class="page-title"><Icon name="lucide:library" /> {t('nav.collections')}</h1>
  <p class="page-lead">{t('collections.lead')}</p>

  <div class="coll-index">
    {groups.map((g) => (
      <a class="coll-index-card" href={localizePath(g.path, lang)}>
        <div class="cic-head">
          <span class="cic-icon"><Icon name={g.icon} /></span>
          <div>
            <h3>{t(g.key)}</h3>
            <span class="cic-count">{g.items.length} {t('collections.items')}</span>
          </div>
          <Icon name="lucide:arrow-right" class="cic-arrow" />
        </div>
        <ul class="cic-preview">
          {g.items.slice(0, 3).map((it) => <li>{it.title}</li>)}
        </ul>
      </a>
    ))}
  </div>
</BaseLayout>
