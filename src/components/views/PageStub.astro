---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang, UIKey } from '@i18n/ui';

interface Props {
  lang: Lang;
  titleKey: UIKey;
  crumb: string;
  term: string;
  icon?: string;
}
const { lang, titleKey, crumb, term, icon = 'lucide:sprout' } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t(titleKey)} variant="page" termPath={term} termWin="wip">
  <div class="crumbs">
    <span>~</span><span class="sep">/</span><span class="cur2">{crumb}</span>
  </div>
  <h1 class="page-title">{t(titleKey)}</h1>
  <div class="notice">
    <Icon name={icon} />
    <div>{t('stub.soon')}</div>
  </div>
</BaseLayout>
