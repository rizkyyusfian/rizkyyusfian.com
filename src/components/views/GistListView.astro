---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations, localizePath } from '@i18n/utils';
import type { Lang } from '@i18n/ui';
import { getGists } from '@/lib/gist';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const gists = await getGists();
const dateFmt = (d: Date) =>
  new Intl.DateTimeFormat(lang === 'id' ? 'id-ID' : 'en-US', { month: 'short', day: '2-digit', year: 'numeric' }).format(d);
---

<BaseLayout lang={lang} title={t('nav.gist')} variant="page" termPath="~/about/gist">
  <div class="crumbs"><span>~</span><span class="sep">/</span><a href="/about">about</a><span class="sep">/</span><span class="cur2">gist</span></div>
  <h1 class="page-title"><Icon name="lucide:code-2" /> {t('nav.gist')}</h1>
  <p class="page-lead">{lang === 'id' ? 'Potongan kode dan hal-hal yang ingin saya simpan.' : 'Code snippets and things worth saving.'}</p>

  <div style="margin-top:16px">
    {gists.map((g) => (
      <a class="file-row" href={localizePath(`/gist/${g.id}`, lang)}>
        <span class="ficon ico-md"><Icon name="lucide:file-code" /></span>
        <div class="fmain">
          <span class="fname">{g.id}<span class="fext">.md</span></span>
          {g.data.tags.length > 0 && <span class="flags">{g.data.tags.map((tag) => <b class="en">{tag}</b>)}</span>}
          <div class="fdesc">{g.data.description}</div>
        </div>
        <span class="fdate">{dateFmt(g.data.pubDate)}</span>
      </a>
    ))}
  </div>
</BaseLayout>
