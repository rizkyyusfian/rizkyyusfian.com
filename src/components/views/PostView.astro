---
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations, localizePath, otherLang } from '@i18n/utils';
import type { Lang } from '@i18n/ui';
import Comments from '@components/Comments.astro';
import { readingTime, availableLangs, baseSlug, getAdjacent, type Post, type Kind } from '../../lib/blog';

interface Props {
  entry: Post | null;
  slug: string;
  lang: Lang;
  section: Kind;
}
const { entry, slug, lang, section } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const langs = await availableLangs(slug);

const sectionPath = section === 'note' ? 'notes' : 'blog';
const postHref = (s: string, l: Lang = lang) => localizePath(`/${sectionPath}/${s}`, l);
const backHref = localizePath(`/${sectionPath}`, lang);
const backLabel = section === 'note' ? t('post.backToNotes') : t('post.backToBlog');

let Content: any = null;
let headings: { depth: number; slug: string; text: string }[] = [];
if (entry) {
  const rendered = await render(entry);
  Content = rendered.Content;
  headings = rendered.headings.filter((h) => h.depth === 2 || h.depth === 3);
}

const title = entry ? entry.data.title : slug;
const description = entry?.data.description;
// Only emit hreflang for translations that actually exist.
const alternates = langs.map((l) => ({ hreflang: l, path: postHref(slug, l) }));
const dateFmt = entry
  ? new Intl.DateTimeFormat(lang === 'id' ? 'id-ID' : 'en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    }).format(entry.data.pubDate)
  : '';
const mins = entry ? readingTime(entry) : 0;

// Previous (newer) / next (older) within the same section + language.
let prevPost: Post | null = null;
let nextPost: Post | null = null;
if (entry) {
  const adj = await getAdjacent(lang, section, slug);
  prevPost = adj.prev;
  nextPost = adj.next;
}
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  variant="reading"
  termPath={`~/${sectionPath}/${slug}.mdx`}
  ogType="article"
  image={entry?.data.cover}
  article={entry ? { published: entry.data.pubDate, updated: entry.data.updated, tags: entry.data.tags } : undefined}
  alternates={alternates}
>
  <div class="crumbs">
    <a href={localizePath('/', lang)}>~</a><span class="sep">/</span>
    <a href={backHref}>{sectionPath}</a><span class="sep">/</span>
    <span class="cur2">{slug}</span>
  </div>

  <article class="article">
    <div class="postlang" aria-label={t('lang.switch')}>
      {['en', 'id'].map((l) =>
        l === lang ? (
          <span class="on">{l.toUpperCase()}</span>
        ) : langs.includes(l as Lang) ? (
          <a href={postHref(slug, l as Lang)}>{l.toUpperCase()}</a>
        ) : (
          <span class="off" aria-disabled="true">{l.toUpperCase()}</span>
        )
      )}
    </div>

    {entry ? (
      <>
        <h1>{entry.data.title}</h1>
        <div class="pmeta">
          <span>{dateFmt}</span>
          <span>{mins} {t('writing.readingTime')}</span>
          {entry.data.tags.length > 0 && (
            <span class="pmeta-tags">
              {entry.data.tags.map((tag) => (
                <a href={localizePath(`/tags/${tag}`, lang)}>#{tag}</a>
              ))}
            </span>
          )}
        </div>
        {headings.length > 0 && (
          <details class="toc-m">
            <summary>{t('post.onThisPage')}</summary>
            <nav aria-label={t('post.onThisPage')}>
              {headings.map((h) => (
                <a href={`#${h.slug}`} class:list={[{ lvl3: h.depth === 3 }]}>{h.text}</a>
              ))}
            </nav>
          </details>
        )}
        <div class="prose">
          <Content />
        </div>

        <div class="artfoot">
          <a href={backHref}>← {backLabel}</a>
        </div>

        {(prevPost || nextPost) && (
          <nav class="post-nav" aria-label="More in this section">
            {prevPost ? (
              <a class="pn prev" href={postHref(baseSlug(prevPost))}>
                <span class="pn-dir">← {t('post.prev')}</span>
                <b>{prevPost.data.title}</b>
              </a>
            ) : (
              <span></span>
            )}
            {nextPost ? (
              <a class="pn next" href={postHref(baseSlug(nextPost))}>
                <span class="pn-dir">{t('post.next')} →</span>
                <b>{nextPost.data.title}</b>
              </a>
            ) : (
              <span></span>
            )}
          </nav>
        )}

        <Comments lang={lang} />
      </>
    ) : (
      <>
        <h1>{slug}</h1>
        <div class="notice">
          <Icon name="lucide:languages" />
          <div>
            {t('post.notAvailable')}{' '}
            {langs.includes(other) && <a href={postHref(slug, other)}>{t('post.readInstead')}</a>}
          </div>
        </div>
        <p class="page-lead"><a href={backHref}>← {backLabel}</a></p>
      </>
    )}
  </article>

  <nav class="toc" slot="toc" aria-label={t('post.onThisPage')}>
    {headings.length > 0 && (
      <>
        <h5>{t('post.onThisPage')}</h5>
        {headings.map((h) => (
          <a href={`#${h.slug}`} class:list={[{ lvl3: h.depth === 3 }]}>{h.text}</a>
        ))}
      </>
    )}
  </nav>
</BaseLayout>
