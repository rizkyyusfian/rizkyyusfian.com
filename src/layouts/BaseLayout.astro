---
import '@styles/global.css';
import { Icon } from 'astro-icon/components';
import Explorer from '@components/Explorer.astro';
import LiveSidebar from '@components/LiveSidebar.astro';
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';
import { site, socials, versions } from '../siteConfig';
import { gitInfo } from '../lib/git';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** 'home' shows the live sidebar, 'reading' shows a TOC slot, 'page' is nav+content only. */
  variant?: 'home' | 'reading' | 'page';
  /** Path shown in the top terminal bar. */
  termPath?: string;
  /** @deprecated no longer rendered; kept so existing call sites don't error. */
  termWin?: string;
  /** OG object type. 'article' for posts/gists, 'website' elsewhere. */
  ogType?: 'website' | 'article';
  /** Social-share image path/URL. Falls back to the site default. */
  image?: string;
  /** Article metadata — enables BlogPosting schema + article:* OG tags. */
  article?: { published?: Date; updated?: Date; tags?: string[] };
  /**
   * Explicit hreflang alternates ({ hreflang, path }). When omitted, the
   * layout assumes the page is mirrored across EN/ID and derives the pair.
   * Pages with partial translations (e.g. blog posts) should pass this.
   */
  alternates?: { hreflang: string; path: string }[];
}

const {
  lang,
  title,
  description = 'Software engineer from Sorong, Indonesia. Digital garden — I write, build, and collect things, in English and Indonesian.',
  variant = 'page',
  termPath = '~/rizkyyusfian',
  ogType = 'website',
  image,
  article,
  alternates,
} = Astro.props;

const t = useTranslations(lang);
const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath, site.url).toString();
const fullTitle = variant === 'home' ? `${site.name} · ${site.handle}` : `${title} · ${site.handle}`;
const year = new Date().getFullYear();

// Absolute social-share image.
const ogImage = new URL(image ?? site.ogImage, site.url).toString();

// hreflang alternates. Derive the EN/ID pair for mirrored pages; blog posts
// pass an explicit list built from the translations that actually exist.
const enPath = lang === 'en' ? currentPath : currentPath.replace(/^\/id(?=\/|$)/, '') || '/';
const idPath = lang === 'id' ? currentPath : currentPath === '/' ? '/id' : `/id${currentPath}`;
// Keep hreflang hrefs byte-identical to canonical (trailing slash, absolute).
const abs = (p: string) => {
  const u = new URL(p, site.url);
  if (!u.pathname.endsWith('/') && !u.pathname.split('/').pop()!.includes('.')) u.pathname += '/';
  return u.toString();
};
const hreflangs = alternates
  ? alternates.map((a) => ({ hreflang: a.hreflang, href: abs(a.path) }))
  : [
      { hreflang: 'en', href: abs(enPath) },
      { hreflang: 'id', href: abs(idPath) },
    ];
const xDefault = abs(enPath);

// Structured data. Person + WebSite site-wide; BlogPosting on articles.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.handle,
  url: site.url,
  email: site.email,
  jobTitle: 'Software Engineer',
  address: { '@type': 'PostalAddress', addressLocality: site.location },
  sameAs: socials.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  inLanguage: lang,
};
const articleLd = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  inLanguage: lang,
  url: canonical,
  image: ogImage,
  datePublished: article.published?.toISOString(),
  dateModified: (article.updated ?? article.published)?.toISOString(),
  keywords: article.tags,
  author: { '@type': 'Person', name: site.name, url: site.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};
const jsonLd = [personLd, websiteLd, ...(articleLd ? [articleLd] : [])];

// Live sidebar shows on home + all normal pages; reading pages (articles, gists)
// stay clean. A reading page shows a TOC column only when a `toc` slot is passed.
const hasToc = Astro.slots.has('toc');
const showLive = variant === 'home' || variant === 'page';
const gridClass = showLive ? 'grid' : variant === 'reading' && hasToc ? 'grid read' : 'grid no-aside';

// Umami analytics (only rendered when configured via PUBLIC_ env vars).
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC || 'https://cloud.umami.is/script.js';

// Language toggle (target locale of the current page).
const stripLang = currentPath.replace(/^\/id(?=\/|$)/, '') || '/';
const otherHref = lang === 'en' ? (stripLang === '/' ? '/id' : `/id${stripLang}`) : stripLang;
const targetLabel = lang === 'en' ? 'ID' : 'EN';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="alternate" type="application/rss+xml" title={`${site.handle} — blog`} href={lang === 'id' ? '/id/rss.xml' : '/rss.xml'} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    {article?.published && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.updated && <meta property="article:modified_time" content={article.updated.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
    {umamiId && <script defer src={umamiSrc} data-website-id={umamiId}></script>}
  </head>
  <body>
    <div class="shell">
      <header class="topbar" data-pagefind-ignore>
        <button type="button" class="navtoggle" id="nav-toggle" aria-label={t('nav.menu')} title={t('nav.menu')} aria-controls="leftnav" aria-expanded="false">
          <Icon name="lucide:menu" />
        </button>
        <span class="prompt-sym">❯</span>
        <span class="path">{termPath}</span>
        <div class="topbar-controls">
          <a class="iconbtn lang-btn" href={otherHref} hreflang={targetLabel.toLowerCase()} aria-label={t('lang.switch')} title={t('lang.switch')}>{targetLabel}</a>
          <button type="button" class="iconbtn" id="theme-toggle" aria-label={t('theme.toggle')} title={t('theme.toggle')}>
            <span class="theme-light-only" aria-hidden="true"><Icon name="lucide:moon" /></span>
            <span class="theme-dark-only" aria-hidden="true"><Icon name="lucide:sun" /></span>
          </button>
        </div>
      </header>

      <div class={gridClass}>
        <aside class="col leftnav" id="leftnav" data-pagefind-ignore>
          <Explorer lang={lang} currentPath={currentPath} />
        </aside>
        <div class="nav-backdrop" id="nav-backdrop"></div>

        <main class="col main" data-pagefind-body>
          <slot />
        </main>

        {showLive && (
          <div class="col aside" data-pagefind-ignore>
            <LiveSidebar lang={lang} />
          </div>
        )}
        {variant === 'reading' && hasToc && (
          <div class="col toccol" data-pagefind-ignore>
            <slot name="toc" />
          </div>
        )}
      </div>

      <footer class="foot">
        <div class="foot-left">
          <span class="verselect">
            <Icon name="lucide:git-branch" />
            <select id="version-switch" aria-label="Site version">
              {versions.map((v) => (
                <option value={v.href ?? ''} selected={v.current}>
                  {v.label}{v.current ? ' ✔' : ''}
                </option>
              ))}
            </select>
          </span>
          <a class="commit" href={gitInfo.url} title={gitInfo.message} rel="noopener">
            <Icon name="lucide:git-commit-horizontal" />
            <span class="sha">{gitInfo.short}</span>
            {gitInfo.relative && <span class="cdate">· {gitInfo.relative}</span>}
          </a>
        </div>
        <div class="foot-right">© {year} {site.initials} · {t('footer.builtWith')}</div>
      </footer>
    </div>

    <script>
      // Mobile nav drawer. The left Explorer column becomes an off-canvas panel
      // below 900px; the topbar hamburger opens it over a dimmed backdrop.
      (() => {
        const toggle = document.getElementById('nav-toggle');
        const drawer = document.getElementById('leftnav');
        const backdrop = document.getElementById('nav-backdrop');
        if (!toggle || !drawer || !backdrop) return;

        let lastFocused: HTMLElement | null = null;

        const isOpen = () => document.body.classList.contains('nav-open');

        const open = () => {
          lastFocused = document.activeElement as HTMLElement;
          document.body.classList.add('nav-open');
          toggle.setAttribute('aria-expanded', 'true');
          // Focus the first focusable element inside the drawer.
          drawer.querySelector<HTMLElement>('a, button, [tabindex]')?.focus();
        };

        const close = () => {
          document.body.classList.remove('nav-open');
          toggle.setAttribute('aria-expanded', 'false');
          lastFocused?.focus();
        };

        toggle.addEventListener('click', () => (isOpen() ? close() : open()));
        backdrop.addEventListener('click', close);
        // Close after navigating to a destination.
        drawer.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && isOpen()) close();
        });
        // Reset when resizing up to the desktop layout.
        const mq = window.matchMedia('(min-width: 901px)');
        mq.addEventListener('change', (e) => {
          if (e.matches && isOpen()) close();
        });
      })();

      // Version switcher — navigates when a target URL exists (visual-only otherwise).
      const sel = document.getElementById('version-switch');
      sel?.addEventListener('change', (e) => {
        const url = (e.target as HTMLSelectElement).value;
        if (url) window.location.href = url;
      });

      // Theme toggle (persisted). No-flash init runs in <head>.
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.getAttribute('data-theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      });
    </script>
  </body>
</html>
