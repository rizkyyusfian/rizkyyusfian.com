---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="404 — not found" variant="page" termPath="~/404" description="Page not found.">
  <div class="crumbs"><span>~</span><span class="sep">/</span><span class="cur2">404</span></div>

  <div class="notfound">
    <div class="nf-code">404</div>
    <div class="cli-line"><span class="pr">❯</span> cd <span class="flag" data-nf-path>the page you wanted</span></div>
    <div class="cli-out">cd: no such file or directory</div>

    <h1 class="page-title"><Icon name="lucide:ghost" /> Page not found</h1>
    <p class="page-lead">This page doesn't exist — it may have moved, been renamed, or never existed at all. Let's get you back on track.</p>

    <div class="nf-links">
      <a href="/"><Icon name="lucide:home" /> home</a>
      <a href="/blog"><Icon name="lucide:pen-line" /> blog</a>
      <a href="/about"><Icon name="lucide:user" /> about</a>
      <a href="/collections"><Icon name="lucide:library" /> collections</a>
    </div>
  </div>
</BaseLayout>

<script>
  // Show the path the visitor actually tried to reach.
  const el = document.querySelector('[data-nf-path]');
  if (el) el.textContent = location.pathname + location.search;
</script>
